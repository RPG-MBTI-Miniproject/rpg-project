# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 GitHub에 올리지 않습니다 (.gitignore 에 등록됨).

# JWT 서명에 쓰는 비밀키. 아무 긴 문자열이나 가능하지만 팀원끼리 같은 값을 써야 합니다.
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# MongoDB 접속 주소
#   Atlas  : mongodb+srv://<아이디>:<비밀번호>@<클러스터>/?retryWrites=true&w=majority
#   로컬   : mongodb://localhost:27017
MONGO_URL=

# 개발 중에는 1, EC2 배포 시에는 0 (디버그 화면에 소스코드가 노출됩니다)
FLASK_DEBUG=1
