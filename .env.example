# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 GitHub에 올리지 않습니다 (.gitignore 에 등록됨).
# EC2 에 올릴 때도 이 파일이 아니라 서버에서 .env 를 직접 만들어야 합니다.


# JWT 서명에 쓰는 비밀키. 아무 긴 문자열이나 가능하지만 팀원끼리 같은 값을 써야 합니다.
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
#
# [배포] 로컬에서 쓰던 키를 그대로 올리지 마세요. 서버용으로 새로 만드세요.
#        이 키가 새어나가면 아무나 남의 로그인 토큰을 위조할 수 있습니다.
JWT_SECRET_KEY=


# MongoDB 접속 주소
#   Atlas  : mongodb+srv://<아이디>:<비밀번호>@<클러스터>/?retryWrites=true&w=majority
#   로컬   : mongodb://localhost:27017
#
# [배포] localhost 는 "EC2 안에 MongoDB가 깔려 있을 때"만 동작합니다.
#        Atlas 를 쓴다면 Atlas 주소를 넣고, Atlas 의 Network Access 에
#        EC2 공인 IP를 허용 목록에 추가해야 합니다.
#        로컬 DB의 글/유저 데이터는 따라오지 않습니다 (서버는 빈 DB로 시작).
MONGO_URL=


# 개발 중에는 1, EC2 배포 시에는 반드시 0
# 1로 두면 에러 화면에 소스코드가 그대로 노출되고,
# Werkzeug 디버거를 통해 서버에서 임의 코드 실행까지 가능해집니다.
FLASK_DEBUG=1


# 쿠키에 Secure 플래그를 붙일지 여부. 'True' 라는 글자와 정확히 일치할 때만 켜집니다
# (true / TRUE / 1 은 전부 False 로 처리됩니다 — app.py 의 == 'True' 비교).
#
# [주의] Secure 쿠키는 HTTPS 로만 전송됩니다.
#        http://<EC2주소>:5000 처럼 평문 HTTP 로 서비스하면서 True 로 두면
#        브라우저가 로그인 쿠키를 아예 저장하지 않아 로그인이 100% 실패합니다.
#        (로그인 -> 바로 로그인 화면으로 되돌아오는 무한 반복)
#
#   HTTP  로 서비스  -> False
#   HTTPS 인증서 붙임 -> True
JWT_COOKIE_SECURE=False
